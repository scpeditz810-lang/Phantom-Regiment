DISCORD_TOKEN=your_bot_token_here

# ── GitHub auto-backup (keeps DB safe across Render restarts) ──
# Create a SEPARATE empty GitHub repo for the database backup.
# Generate a Personal Access Token at https://github.com/settings/tokens (repo scope).
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=https://github.com/yourname/command-army-data.git
# Optional: Partner clan secondary bot token (multi-bot host)
PARTNER_BOT_TOKEN=

# ── Discord OAuth2 Configuration ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:10000/callback
GUILD_ID=1550544659217125467
SECRET_KEY=some_random_secret_key
